# ========= SMM HUB — Configuração de ambiente =========

PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# --- Autenticação ---
JWT_SECRET=troque-isto-em-producao-com-48-bytes-aleatorios
JWT_EXPIRES=7d

# --- Driver de banco ---
# Somente sqlite é suportado nesta versão.
DB_DRIVER=sqlite
PG_HOST=localhost
PG_PORT=5432
PG_USER=smmhub
PG_PASSWORD=
PG_DATABASE=smmhub

# --- Pix (gateway real) ---
PIX_PROVIDER=disabled
PIX_KEY=financeiro@smmhub.com.br
PIX_MERCHANT_NAME=SMM HUB BRASIL
PIX_MERCHANT_CITY=SAO PAULO
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERT_PATH=
EFI_SANDBOX=true

# --- Cripto ---
CRYPTO_PROVIDER=disabled
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# --- SMTP (e-mail transacional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@smmhub.com.br
MAIL_ENABLED=false

# --- Afiliados ---
AFFILIATE_L1_PCT=5
AFFILIATE_L2_PCT=2
AFFILIATE_L3_PCT=1
AFFILIATE_L4_PCT=0.5
CASHBACK_PCT=3
AFFILIATE_MIN_ACCOUNT_HOURS=24

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Admin inicial ---
ADMIN_EMAIL=admin@smmhub.com
ADMIN_PASSWORD=admin123
DEMO_EMAIL=demo@smmhub.com
DEMO_PASSWORD=demo123

# --- Telegram alertas ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# --- CAPTCHA (hCaptcha ou Turnstile) ---
CAPTCHA_PROVIDER=none
HCAPTCHA_SECRET=
HCAPTCHA_SITE_KEY=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=

# --- Job queue ---
# Somente sqlite é suportado nesta versão.
QUEUE_DRIVER=sqlite
REDIS_URL=redis://localhost:6379

# --- Prometheus ---
METRICS_ENABLED=true
METRICS_TOKEN=change-me-metrics

# --- Instagram / TikTok (worker assinaturas) ---
INSTAGRAM_GRAPH_TOKEN=
RAPIDAPI_KEY=

# --- Maintenance mode ---
MAINTENANCE=false
MAINTENANCE_WHITELIST_IPS=127.0.0.1,::1

# Gere chaves com npm run setup:env antes da primeira implantação.
SETTINGS_ENCRYPTION_KEY=
APP_PUBLIC_URL=https://seu-dominio.example
TRUST_PROXY=loopback
