# Copie para .env. Sem chaves reais, o sistema sobe em sandbox e dá para testar no localhost.

DATABASE_URL=postgresql://nh:nh@localhost:5432/novos_horizontes
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
NODE_ENV=development

# Troque antes de qualquer deploy. Mínimo de 32 caracteres.
AUTH_SECRET=troque-este-segredo-com-32-caracteres
WEBHOOK_SECRET=troque-este-segredo-de-webhook

# sandbox | asaas | openpix
PAYMENT_PROVIDER=sandbox
# sandbox | live
SUPPLIER_MODE=sandbox
# true no localhost para o pedido ser despachado na hora, sem esperar o worker.
INLINE_JOBS=true

ASAAS_API_KEY=
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
OPENPIX_APP_ID=
OPENPIX_API_URL=https://api.openpix.com.br/api/v1
OPENPIX_WEBHOOK_SECRET=

CJ_API_KEY=
CJ_API_URL=https://developers.cjdropshipping.com/api2.0/v1
CJ_LOGISTIC_NAME=
CJ_FROM_COUNTRY=BR
# Cotação manual enquanto não houver fonte de câmbio. A CJ devolve saldo em USD.
USD_BRL_RATE=5.40
CJ_LOW_BALANCE_THRESHOLD_CENTS=40000

BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
BLING_REFRESH_TOKEN=
BLING_API_URL=https://api.bling.com.br/Api/v3

EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=novos-horizontes
# Áudio opcional. Sem URL, o lembrete vai só em texto. Não invente urgência operacional.
RECOVERY_AUDIO_URL=
RECOVERY_AUDIO_PTT=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

PLATFORM_SPREAD=1.35
RETAIL_MULTIPLIER=2.5
# R$ 2.000,00 — saldo mestre em BRL (sandbox e Bling).
LOW_BALANCE_THRESHOLD_CENTS=200000
MIN_DEPOSIT_CENTS=15000
# Produção: 420000 (7 minutos). Local: 15000 deixa o lembrete fácil de ver.
ABANDONED_PIX_DELAY_MS=420000
PIX_EXPIRES_MINUTES=30
WATCHDOG_INTERVAL_MS=600000
LOW_STOCK_THRESHOLD=5
