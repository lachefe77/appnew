# Arena Arcade — variáveis de ambiente
# Copie para .env e preencha antes de iniciar o servidor

# Obrigatório em produção
NODE_ENV=production
PORT=3000
HOST=127.0.0.1
# Créditos de teste somente em NODE_ENV=development. Nunca ativa fundos reais.
# PIX / dinheiro real permanece desabilitado nesta versão.
ENABLE_SIMULATED_FUNDS=0

# Senha do administrador (email padrão: admin@arena.gg)
ADMIN_PASSWORD=troque_esta_senha_agora
# ADMIN_EMAIL=admin@arena.gg

# Origem permitida para CORS (ex: https://seu-dominio.com)
# Deixe * apenas em dev
ALLOWED_ORIGIN=*

# Caminho do banco SQLite (padrão: data/arena.db)
# DB_PATH=/var/lib/arena/arena.db

# Revisão após interrupção/divergência: prazo padrão de 24 horas.
# Após o prazo, estorno sem atribuição de vitória. Não habilita dinheiro real.
MATCH_REVIEW_MS=86400000

# Limite diário de perda em créditos (centavos) para desafios APOSTADO. Padrão 50.00.
DAILY_LOSS_LIMIT_CENTS=5000

# Intervalo do placar ao vivo (SCOREBOARD_UPDATE) em partidas RUNNING.
# SCOREBOARD_INTERVAL_MS=2000

# Graça de reconexão; após RUNNING com rageQuit=loss, forfeit ao oponente.
# RECONNECT_GRACE_MS=30000

# Execução oficial dos desafios de demonstração com créditos (KOF 2002).
# Prepare os ZIPs privados com npm run setup:hosted (não faz download de jogos).
HOSTED_MAX_SESSIONS=1
# HOSTED_GAME_DIR=C:/caminho/privado/kof2002
# No Windows usa Edge instalado. Em outro host configure o navegador Chromium.
# HOSTED_BROWSER_PATH=/caminho/para/chromium
# STUN/TURN estáticos (JSON). Credenciais efêmeras: use TURN_URLS + TURN_SECRET.
HOSTED_ICE_SERVERS=[]
# URLs TURN separadas por vírgula (ex: turn:turn.example.com:3478?transport=udp)
# TURN_URLS=
# Segredo compartilhado com coturn (REST / use-auth-secret). Emite username/credential HMAC.
# TURN_SECRET=
# Validade da credencial efêmera em segundos (padrão 3600).
# TURN_TTL_SEC=3600
# ETA da fila hosted = posição * HOSTED_AVG_MATCH_SEC (padrão 180).
# HOSTED_AVG_MATCH_SEC=180

# Segurança — obrigatório em produção
# HMAC_SECRET=chave_aleatoria_com_pelo_menos_32_caracteres
# Admin IP allowlist (separado por vírgula). Vazio = desabilitado (apenas em lab).
# Em produção, restrinja:
# ADMIN_IP_ALLOWLIST=127.0.0.1,192.168.1.0/24

# PIX (Asaas — NÃO preencher até a integração oficial; dinheiro real continua off)
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# ASAAS_ENVIRONMENT=sandbox

# Email (Resend — opcional para notificações)
# RESEND_API_KEY=
# EMAIL_FROM=noreply@seu-dominio.com
