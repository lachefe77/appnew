{
  "name": "arcade-rgc-platform",
  "version": "1.0.0",
  "description": "Next-Gen Arcade Netplay Platform with Real-Time Rooms, Crossplay & PIX Escrow",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test tests/critical-flow.test.js tests/rom-check.test.js tests/hosted.test.js tests/controls.test.js tests/controller-settings.test.js tests/snapshot.test.js tests/hardening.test.js tests/match-product.test.js tests/theme-settings.test.js tests/sistema-1a9.test.js tests/sistema-10a30.test.js tests/host-bot.test.js",
    "test:host-bot": "node --test tests/host-bot.test.js",
    "db:backup": "node scripts/database-backup.js backup",
    "db:verify": "node scripts/database-backup.js verify",
    "db:restore": "node scripts/database-backup.js restore",
    "db:offbox": "node scripts/offbox-backup.js",
    "health:check": "node scripts/check-health.js",
    "setup:emulator": "node scripts/setup-emulatorjs.js",
    "setup:hosted": "node scripts/setup-hosted-game.js",
    "test:local": "node scripts/start-local-test.js",
    "smoke:host-bot": "node scripts/smoke-host-bot.js",
    "bench:host-bot": "node scripts/bench-host-bot-capacity.js",
    "smoke:hosted-queue": "node scripts/smoke-hosted-queue.js",
    "smoke:retroarch-alive": "node scripts/smoke-retroarch-alive.js",
    "check:host-bot": "node scripts/check-host-bot-ready.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@roamhq/wrtc": "^0.8.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "playwright-core": "1.64.1",
    "ws": "^8.18.0"
  }
}
